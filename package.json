{
  "name": "greenmech",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "vite",
    "dev:emu": "VITE_USE_EMULATORS=1 firebase emulators:exec --only auth,firestore \"vite --port 5173\"",
    "build": "tsc --noEmit && vite build && node scripts/write-version.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "format": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"functions/**/*.ts\"",
    "contrast": "tsx scripts/contrast.ts",
    "rules:gen": "tsx scripts/gen-rules.ts",
    "rules:check": "tsx scripts/check-rules-sync.ts",
    "test:unit": "vitest run tests/unit",
    "test:rules": "tsx scripts/gen-rules.ts --admins admin@test.example --out tests/rules/.test.rules && firebase emulators:exec --only firestore \"vitest run tests/rules\"",
    "test:e2e": "npm run build:e2e && firebase emulators:exec --only auth,firestore \"playwright test\"",
    "build:e2e": "tsx scripts/gen-rules.ts --admins admin@test.example --out tests/rules/.test.rules && VITE_USE_EMULATORS=1 vite build --outDir dist-e2e",
    "size": "node scripts/size.mjs",
    "gate:a": "npm run typecheck && npm run lint && npm run format && npm run contrast && npm run rules:check && npm run test:unit && npm run test:rules && npm run build && npm run size && npm run test:headers && npm run test:e2e",
    "test:headers": "node scripts/headers-check.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/16JoeTheCoder/greenmech.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/16JoeTheCoder/greenmech/issues"
  },
  "homepage": "https://github.com/16JoeTheCoder/greenmech#readme",
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@preact/signals": "^2.11.4",
    "firebase": "^12.19.0",
    "preact": "^11.1.1",
    "wouter-preact": "^3.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261103.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@tabler/icons": "^3.50.0",
    "eslint": "^10.14.0",
    "firebase-tools": "^15.34.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "private": true,
  "type": "module",
  "overrides": {
    "@firebase/app-compat": "0.5.21",
    "@firebase/app": "0.16.5"
  }
}
